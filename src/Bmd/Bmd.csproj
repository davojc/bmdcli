<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>bmd</AssemblyName>
    <RootNamespace>Bmd</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Pre-empts the SDK's implicit "1.0.0" default so $(Version) is always meaningful by the
         time GenerateBuildInfo (below) reads it — a plain `dotnet build` with no -p:Version then
         reports "0.0.0-dev" instead of falsely claiming to be 1.0.0, and a deliberate
         `-p:Version=1.0.0` release is reported honestly as 1.0.0 rather than being confused for
         the SDK default. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ConsoleAppFramework" Version="5.7.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Bmd.Tests" />
  </ItemGroup>

  <!-- Stamps the build's $(Version) and $(RuntimeIdentifier) into a generated constant class
       (BuildInfo.g.cs) rather than relying on AssemblyInformationalVersionAttribute, because
       reading that back at runtime means reflection, which this project forbids for Native AOT
       reasons. A const string is exact, trivially AOT-safe, and directly testable.

       SECURITY: $(Version) and $(RuntimeIdentifier) are embedded directly into a C# string
       literal in generated source that gets compiled into the shipped binary. Both values are
       typically driven by a git tag or CI parameter — untrusted input from whoever can push a
       tag. Without the <Error> whitelist checks below, a version string containing a `"` closes
       the literal early, and the remaining template text keeps parsing as C#: a crafted tag can
       inject an arbitrary static-constructor body (which runs the first time BuildInfo is
       touched, i.e. whenever `bmd version` runs) straight into the release binary. Do not remove
       these checks as "redundant" — they are the only thing standing between an untrusted tag and
       code execution in the shipped bmd.exe. Fail the build rather than silently stripping or
       escaping the offending characters — a mangled version string is its own bug and should be
       loud, not silently "fixed" into something else. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="BeforeCompile">
    <PropertyGroup>
      <_BmdVersion>$(Version)</_BmdVersion>
      <_BmdRid Condition="'$(RuntimeIdentifier)' == ''">unknown</_BmdRid>
      <_BmdRid Condition="'$(_BmdRid)' == ''">$(RuntimeIdentifier)</_BmdRid>
      <_BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</_BuildInfoFile>
    </PropertyGroup>
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_BmdVersion)', '^[A-Za-z0-9.+-]+$'))"
           Text="Version '$(_BmdVersion)' contains characters that are not allowed when stamping the binary. Use only letters, digits, dot, plus and hyphen." />
    <Error Condition="!$([System.Text.RegularExpressions.Regex]::IsMatch('$(_BmdRid)', '^[a-z0-9.-]+$'))"
           Text="RuntimeIdentifier '$(_BmdRid)' contains characters that are not allowed when stamping the binary. Use only lowercase letters, digits, dot and hyphen." />
    <ItemGroup>
      <_BuildInfoLines Include="// Generated by the GenerateBuildInfo target. Do not edit." />
      <_BuildInfoLines Include="namespace Bmd%3B" />
      <_BuildInfoLines Include="internal static class BuildInfo" />
      <_BuildInfoLines Include="{" />
      <_BuildInfoLines Include="    public const string Version = &quot;$(_BmdVersion)&quot;%3B" />
      <_BuildInfoLines Include="    public const string RuntimeIdentifier = &quot;$(_BmdRid)&quot;%3B" />
      <_BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(_BuildInfoFile)" Lines="@(_BuildInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(_BuildInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
